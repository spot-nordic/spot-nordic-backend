{
  "name": "spot-nordic-backend",
  "version": "1.0.0",
  "description": "Spot Nordic Backend E-Commerce and Documentation Platform",
  "main": "dist/server.js",
  "scripts": {
    "start": "NODE_ENV=production node dist/server.js",
    "dev": "NODE_ENV=development ts-node-dev --respawn --transpile-only src/server.ts",
    "build:force": "tsc --noEmit false --skipLibCheck true --skipDefaultLibCheck true --noErrorTruncation true --pretty false && tsc-alias",
    "start:dev": "NODE_ENV=development ts-node src/server.ts",
    "start:prod": "NODE_ENV=production node dist/server.js",
    "build": "tsc && tsc-alias",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "db:generate": "NODE_ENV=development npx drizzle-kit generate --config=src/configs/drizzle.config.ts",
    "db:push": "NODE_ENV=development npx drizzle-kit push --config=src/configs/drizzle.config.ts",
    "db:migrate": "NODE_ENV=development npx drizzle-kit migrate --config=src/configs/drizzle.config.ts",
    "db:seed": "NODE_ENV=development ts-node src/utils/seed/index.ts",
    "db:studio": "NODE_ENV=development drizzle-kit studio",
    "db:destroy": "NODE_ENV=development ts-node src/utils/dbDestroy.ts",
    "db:migrate:prod": "node dist/utils/migrate.js",
    "seed": "NODE_ENV=development ts-node src/utils/seed/index.ts",
    "seed:destroy": "NODE_ENV=development ts-node src/utils/seed/index.ts -d"
  },
  "keywords": [
    "nodejs",
    "typescript",
    "postgres",
    "drizzle",
    "redis",
    "jwt",
    "authentication"
  ],
  "author": "Spot Nordic",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1053.0",
    "@aws-sdk/client-ses": "^3.1077.0",
    "@aws-sdk/lib-storage": "^3.1053.0",
    "@aws-sdk/s3-request-presigner": "^3.1053.0",
    "@clickhouse/client": "^1.18.5",
    "amqplib": "^2.0.1",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "form-data": "^4.0.5",
    "helmet": "^8.2.0",
    "joi": "^18.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.6.2",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.8",
    "ollama": "^0.6.3",
    "pdfkit": "^0.18.0",
    "pg": "^8.21.0",
    "razorpay": "^2.9.6",
    "redis": "^5.12.1",
    "resend": "^6.12.3",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "uuid": "^14.0.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^10.4.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
